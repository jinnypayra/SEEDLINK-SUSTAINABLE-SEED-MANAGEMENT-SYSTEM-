# FAKE RECORD FOR TESTING
class FakeRecord:
    def to_dict(self):
        return {
            "crop": {"name": "mango"},
            "exchange": {"source": "test"},
        }
# 1. TEST: no file exist
def test_load_no_file(tmp_path, monkeypatch):
    monkeypatch.chdir(tmp_path)

    result = load_data()
    assert result == {}

# 2. TEST: valid file load
def test_load_valid_file(tmp_path, monkeypatch):
    monkeypatch.chdir(tmp_path)

    sample = {
        "crop": {"name": "mango"},
        "exchange": {"source": "test"}
    }

    with open(DATA_FILE, "w") as f:
        json.dump(sample, f)

    result = load_data()
    assert result["crop"]["name"] == "mango"

# 3. TEST: CORRUPTED JSON
def test_load_corrupted_file(tmp_path, monkeypatch):
    monkeypatch.chdir(tmp_path)

    with open(DATA_FILE, "w") as f:
        f.write("{invalid json")

    result = load_data()

    assert result is not None

# 4. TEST: save data
def test_save_data(tmp_path, monkeypatch, capsys):
    monkeypatch.chdir(tmp_path)

    record = FakeRecord()

    save_data(record)

    # check file created
    with open(DATA_FILE, "r") as f:
        data = json.load(f)

    assert data["crop"]["name"] == "mango"

    # check print output
    captured = capsys.readouterr()
    assert "Data saved locally" in captured.out