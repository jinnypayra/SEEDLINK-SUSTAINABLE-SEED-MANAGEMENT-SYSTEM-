# CROP TESTS
def test_crop_properties():
    crop = Crop("mango", "PH-001", "high", "food")

    assert crop.name == "mango"
    assert crop.seed_id == "PH-001"
    assert crop.resilience == "high"
    assert crop.use == "food"


def test_crop_str():
    crop = Crop("mango", "PH-001", "high", "food")

    assert str(crop) == "Crop(mango, ID=PH-001)"


# EXCHANGE TESTS
def test_exchange_properties():
    ex = Exchange(
        crop_name="mango",
        source="farm",
        destination="PH",
        date=date(2024, 1, 1)
    )

    assert ex.crop_name == "mango"
    assert ex.source == "farm"
    assert ex.destination == "PH"
    assert ex.date.year == 2024


def test_exchange_str():
    ex = Exchange(
        crop_name="mango",
        source="farm",
        destination="PH",
        date=date(2024, 1, 1)
    )

    assert "mango" in str(ex)
    assert "farm" in str(ex)
    assert "PH" in str(ex)



